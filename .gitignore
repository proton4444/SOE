# Game runtime data (optional - may want to commit example games)
# Uncomment if you don't want to track game state in git:
# games/*/state.json
# games/*/reports/
# games/*/orders/

# Web server runtime data
server_data/

# Local artifacts
nul
_tmp_map.svg
.playwright-mcp/

# Trailer and storyboard artwork: large generated binaries kept on disk only.
# Roughly 34 MB of PNGs that would otherwise sit in history forever and be
# re-downloaded on every clone. They are production working files, not source.
trailer/
assets/trailer/

# Per-call arena traces: one file per model call, thousands per official run.
# The pre-commit scanner spawns two processes per staged file, so tracking
# these makes every later commit slower without bound. The evidence that the
# gate actually cites -- manifest.json, arena_results.json, ARENA_REPORT.md,
# games.jsonl and turns.jsonl -- stays tracked; the raw traces stay on disk.
games/arena/*/decisions/
games/arena/*/orders/

# Third-party source material: development inputs only, never distributed.
# See docs/ip_cleanroom.md.
reference/

# Maps derived from that source material, and everything rendered from them.
# They stay on disk so games already in progress keep resolving their town
# ids; they are simply not distributed. New games use maps/world.json and
# maps/starter_map.json, both produced by scripts/generate_world.py.
maps/sample_map.json
maps/soe_world.json
maps/soe_geography.json
maps/soe_world_map.png
maps/soe_world_map.svg
maps/soe_world_map_print.svg
maps/webapp_landing_map.png
maps/webapp_map_only.png
maps/compare_web_vs_poster.png
maps/_web_preview.svg


# Live room game data: runtime state, not source. Stays on disk.
games/room_*/
